{{ define "modules/home/html/home" }}

{{ template "templates/layouts/html/head" . }}
{{ template "templates/layouts/html/navbar" . }}
{{ template "templates/layouts/html/header" . }}

<!-- Begin Featured -->
<section class="featured-posts">
    <div class="section-title">
        <h2><span>Featured</span></h2>
    </div>

    <div class="card-columns listfeaturedtag">
        {{ range .Featured.Data }}
        <div class="card">
            <div class="row">
                <div class="col-md-5 wrapthumbnail">
                    <a href="/article/{{ .ID }}">
                        <div class="thumbnail"
                             style="background-image:url('{{ .Image }}');">
                        </div>
                    </a>
                </div>

                <div class="col-md-7">
                    <div class="card-block">
                        <h2 class="card-title">
                            <a href="/article/{{ .ID }}">{{ .Title }}</a>
                        </h2>

                        <h4 class="card-text">{{ .Content }}</h4>

                        <div class="metafooter">
                            <div class="wrapfooter">
                                <span class="meta-footer-thumb">
                                    <img class="author-thumb"
                                         src="{{ .User.Image }}"
                                         alt="{{ .User.Name }}">
                                </span>

                                <span class="author-meta">
                                    <span class="post-name">{{ .User.Name }}</span><br>
                                    <span class="post-date">{{ .CreatedAt }}</span>
                                </span>
                            </div>
                        </div>

                    </div>
                </div>
            </div>
        </div>
        {{ end }}
    </div>
</section>

<!-- Begin Stories -->
<section class="recent-posts">

    <div class="section-title">
        <h2><span>All Stories</span></h2>
    </div>

    <div class="card-columns listrecent">

        {{ range .stories.Data }}
        <div class="card">

            <a href="/article/{{ .ID }}">
                <img class="img-fluid"
                     src="{{ .Image }}"
                     alt="{{ .Title }}">
            </a>

            <div class="card-block">

                <h2 class="card-title">
                    <a href="/article/{{ .ID }}">{{ .Title }}</a>
                </h2>

                <h4 class="card-text">{{ .Content }}</h4>

                <div class="metafooter">
                    <div class="wrapfooter">

                        <span class="meta-footer-thumb">
                            <img class="author-thumb"
                                 src="{{ .User.Image }}"
                                 alt="{{ .User.Name }}">
                        </span>

                        <span class="author-meta">
                            <span class="post-name">{{ .User.Name }}</span><br>
                            <span class="post-date">{{ .CreatedAt }}</span>
                        </span>

                    </div>
                </div>

            </div>
        </div>
        {{ end }}

    </div>
</section>

{{ template "templates/layouts/html/footer" . }}
{{ template "templates/layouts/html/foot" . }}

{{ end }}